# Copia este archivo como .env (solo para desarrollo local).
# En producción (Render) estas variables van en el panel, no en un archivo.

# DATABASE_URL y DATABASE_URL_UNPOOLED no van aquí: `neon deploy` / `neon env pull`
# (en la raíz) los escribe en ../.env.local, que el servidor carga solo.

# Firma las sesiones. Genera uno con:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"

# Código que hay que escribir para crear una cuenta. Solo tú y tu novia lo conocen.
INVITE_CODE="cambia-este-codigo"

PORT=3000

# Fase 3
NTFY_TOPIC="my-place-cambia-esto-por-algo-dificil-de-adivinar"
