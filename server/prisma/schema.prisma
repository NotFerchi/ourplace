// Our Place — esquema de base de datos (PostgreSQL serverless en Neon)
// Las formas de Task y Block son las mismas que el frontend guarda hoy en
// localStorage, así la Fase 2 solo cambia de dónde vienen los datos.
//
// Escrito para Prisma 6 (npm i -D prisma@6 && npm i @prisma/client@6).
// Desde Prisma 7 la URL se mueve a prisma.config.ts; fijamos la versión en la Fase 2.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Conexión "pooled" de Neon (host con -pooler): la usa la app en ejecución
  url       = env("DATABASE_URL")
  // Conexión directa de Neon (sin -pooler): la usa Prisma Migrate
  directUrl = env("DIRECT_URL")
}

enum Category {
  ESCUELA
  PROYECTO
  PERSONAL
}

enum Priority {
  ALTA
  MEDIA
  BAJA
}

// De dónde viene una tarea: creada en la app o importada de un servicio
enum Source {
  MANUAL
  CLICKUP
  CLASSROOM
  TEAMS
}

// Servicios externos que se pueden conectar
enum Provider {
  CLICKUP
  CLASSROOM
  TEAMS
}

enum BlockType {
  CLASE
  ESTUDIO
  GYM
  DESARROLLO
  OTRO
}

// Cuenta de usuario (login). Cada tarea y bloque pertenece a un usuario.
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  tasks        Task[]
  blocks       Block[]
  integrations Integration[]
}

model Task {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  // Notas libres (máx. 2000 caracteres, lo valida la API)
  notes       String?   @db.Text
  category    Category  @default(PERSONAL)
  priority    Priority  @default(MEDIA)
  dueAt       DateTime  @db.Timestamptz(3)
  // false = "para ese día" sin hora exacta; true = entrega con hora
  dueHasTime  Boolean   @default(false)
  done        Boolean   @default(false)
  completedAt DateTime? @db.Timestamptz(3)
  // Fase 3: marca cuándo se envió la alerta por ntfy para no repetirla
  notifiedAt  DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)
  // Importación: origen, id en el origen y enlace para abrirla allá
  source      Source    @default(MANUAL)
  externalId  String?
  externalUrl String?

  @@unique([userId, source, externalId])
  @@index([userId, done, dueAt])
  @@index([category])
}

// Conexión de un usuario con un servicio externo. Los tokens van cifrados
// (AES-256-GCM con TOKEN_ENC_KEY) y nunca salen del servidor.
model Integration {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider        Provider
  tokenEnc        String
  refreshTokenEnc String?
  expiresAt       DateTime? @db.Timestamptz(3)
  // Ajustes de la conexión, p. ej. { "category": "PROYECTO" }
  config          Json?
  lastSyncAt      DateTime? @db.Timestamptz(3)
  lastError       String?
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)

  @@unique([userId, provider])
}

model Block {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title        String
  type         BlockType @default(OTRO)
  // Día del bloque en formato YYYY-MM-DD (hora local del usuario).
  // En una serie es el primer día; la regla vive en shared/schedule.js
  date         String    @db.VarChar(10)
  // 0 = domingo … 6 = sábado; vacío = solo el día de `date`
  weekdays     Int[]     @default([])
  // Último día de la serie (YYYY-MM-DD, opcional)
  rangeEnd     String?   @db.VarChar(10)
  // Fechas YYYY-MM-DD excluidas de la serie
  skipDates    String[]  @default([])
  // Minutos desde la medianoche (ej. 7:30 → 450)
  startMin     Int       @db.SmallInt
  endMin       Int       @db.SmallInt
  // Compatibilidad (antes de `weekdays`): el servidor los mantiene derivados
  // weekday = día de la semana de `date`; repeatWeekly = weekdays no vacío
  weekday      Int       @db.SmallInt
  repeatWeekly Boolean   @default(false)
  // Fase 3: último día (YYYY-MM-DD) en que se avisó de este bloque
  notifiedOn   String?   @db.VarChar(10)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)

  @@index([userId, date])
  @@index([repeatWeekly, weekday])
}
